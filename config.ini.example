[PERSONAL_INFO]
; Account and current appointment info from https://ais.usvisa-info.com
USERNAME = account@gmail.com
PASSWORD = account_pass
; Find SCHEDULE_ID in re-schedule page link:
; https://ais.usvisa-info.com/en-am/niv/schedule/{SCHEDULE_ID}/appointment
SCHEDULE_ID = 99999999
; Target Period (YYYY-MM-DD, must be valid calendar dates):
PERIOD_START = 2027-10-01
PERIOD_END = 2027-11-30
; Dates to skip even if inside the window (never notified or booked). Leave blank
; for none. Comma-separated; each item is a single day or an inclusive range:
;   EXCLUDE_DATES = 2027-10-15, 2027-11-01:2027-11-07, 2027-11-25
EXCLUDE_DATES =
; Change "en-am-yer", based on your embassy Abbreviation in embassy.py list.
YOUR_EMBASSY = en-am-yer
; True  = auto-book the earliest date found inside your window, then stop.
; False = only notify (you reschedule manually).
AUTO_RESCHEDULE = True
; Safety rail: never book a date at or after the appointment you already hold,
; even if it falls inside the target window. Leave True unless you really want
; to be able to move the appointment later.
ONLY_EARLIER = True
; Give up auto-booking after this many failed attempts and fall back to
; notify-only (0 = unlimited). The site allows only a handful of reschedules,
; so this keeps a stale/contended date from burning the whole quota.
MAX_RESCHEDULE_ATTEMPTS = 6

[CHROMEDRIVER]
; Details for the script to control Chrome
LOCAL_USE = True
; Headless works as long as the stealth options in visa.py stay in place (a
; *default* headless fingerprint is 403'd by the site's WAF). The NixOS service
; runs under xvfb-run, so HEADLESS = False is fine there too.
HEADLESS = False
; Optional: override browser/driver paths (set automatically on NixOS)
CHROME_BIN =
CHROMEDRIVER_PATH =
USER_AGENT =
; Stop the service after this many consecutive login failures (0 = unlimited)
MAX_LOGIN_ATTEMPTS = 3
; Optional: HUB_ADDRESS is mandatory only when LOCAL_USE = False
HUB_ADDRESS = http://localhost:9515/wd/hub

[NOTIFICATION]
; Discord bot notifications (https://discord.com/developers/applications)
; 1. Create an application -> Bot -> Reset Token -> copy DISCORD_BOT_TOKEN
; 2. Enable "Message Content Intent" under Bot settings if needed
; 3. Invite the bot to your server (OAuth2 -> URL Generator -> bot scope + Send Messages)
; 4. Right-click the target channel -> Copy Channel ID (enable Developer Mode in Discord settings)
DISCORD_BOT_TOKEN =
DISCORD_CHANNEL_ID =

[TIME]
; Time between retries/checks for available dates (seconds)
RETRY_TIME_L_BOUND = 10
RETRY_TIME_U_BOUND = 120
; Cooling down after WORK_LIMIT_TIME hours of work (Avoiding Ban)(hours).
; Mind the ratio: the cooldown is a blind spot. A 1h-on/2h-off cycle inside a
; 10h ACTIVE_HOURS window covers only ~32% of it and leaves 135-minute gaps a
; cancellation can appear and vanish in. Prefer a long work period with a short
; break, and buy back the request volume with a slower RETRY_TIME_U_BOUND —
; polling the whole window slowly beats a fast burst followed by a long blind
; spot. Set WORK_LIMIT_TIME = 0 to disable the break entirely.
WORK_LIMIT_TIME = 1.5
WORK_COOLDOWN_TIME = 2.25
; Temporary Banned (empty list): wait COOLDOWN_TIME (hours)
BAN_COOLDOWN_TIME = 5
; IANA timezone used for ACTIVE_HOURS and the daily report boundary. Blank =
; the machine's local time (set this if the server clock isn't the consulate's).
TIMEZONE = America/Toronto
; Only poll during these local-time windows; the bot signs out, closes the
; browser and sleeps the rest of the day (far fewer requests = far less ban
; exposure). Blank = around the clock. Comma-separated HH:MM-HH:MM ranges,
; a range may wrap past midnight:
;   ACTIVE_HOURS = 12:00-20:00
;   ACTIVE_HOURS = 08:00-09:30, 13:00-17:00
ACTIVE_HOURS =
; After a failed booking, don't re-attempt that same date for this many minutes
; (every POST spends one of the site's limited reschedule attempts).
RESCHEDULE_RETRY_COOLDOWN = 20
; Collapse repeated identical error notifications within this many minutes
; (0 = send every one). SUCCESS/FOUND/LIMIT/STOP/... are never collapsed.
NOTIFY_MIN_INTERVAL = 15
; Poll a little sooner right after the available-date list changes, drifting
; back to RETRY_TIME_U_BOUND while nothing moves. Never goes outside the bounds.
ADAPTIVE_PACING = True
ADAPTIVE_RAMP_POLLS = 10
; What an empty date list means:
;   auto  = check the appointment page: still rendering for us -> the consulate
;           simply has nothing open (keep polling); blocked -> soft ban (sleep)
;   ban   = always assume a ban and sleep BAN_COOLDOWN_TIME (old behaviour)
;   retry = never assume a ban, just keep polling
EMPTY_LIST_POLICY = auto
; The `auto` probe is a full HTML page load; cache its verdict for this many
; minutes. Running it on every empty poll is itself enough extra traffic to get
; rate-limited (observed: 58 probes in 37 minutes, then a soft ban).
EMPTY_PROBE_MIN_INTERVAL = 10
; Consecutive empty lists are usually the site warming up to rate-limit you.
; Stretch the poll interval by the streak length, up to this multiple
; (1 = disable, poll at the normal cadence through an empty streak).
EMPTY_STREAK_BACKOFF_MAX = 8

[LOGGING]
; Rotating daily log file lives in LOG_DIR/visa.log, debug page dumps in
; LOG_DIR/debug/.
LOG_DIR = logs
LOG_RETENTION_DAYS = 14
DEBUG_ARTIFACT_LIMIT = 20
