[Unit]
Description=US Visa Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
Environment=PATH=@INSTALL_DIR@/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@INSTALL_DIR@/.venv/bin/python @INSTALL_DIR@/visa.py
# on-failure, NOT always: visa.py exits 0 on purpose once the appointment is
# booked. Restart=always would bring it straight back up and fire another
# reschedule for the date it just booked, spending one of the site's limited
# reschedule attempts.
Restart=on-failure
RestartSec=30
# visa.py writes its own rotating log to @INSTALL_DIR@/logs/visa.log; stdout
# goes to the journal (journalctl -u visa-scheduler) instead of an unbounded
# append file.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
